# FUnTiDES solver parameter file — acoustic modeling example
# Format: key = value   (inline # comments are ignored)

# --- Mesh ---
lx = 2000.0             # global domain length X [m]
ly = 2000.0             # global domain length Y [m]
lz = 1040.0             # global domain length Z [m]
ex = 40                 # elements in X
ey = 40                 # elements in Y
ez = 26                 # elements in Z
order = 2               # polynomial order (1, 2 or 3)
mesh_type = STRUCT      # STRUCT or UNSTRUCT
on_nodes = False        # physical model on elements (False) or nodes (True)
is_elastic = False
free_surface_on_top = True

# --- Physical model defaults ---
vp = 1500.0             # P-wave velocity [m/s]
rho = 1.0               # density (normalized)

# --- Time ---
dt = 0.001              # time step [s]
minTime = 0.0           # simulation start time [s]
maxTime = 1.0           # simulation end time [s]
dtSeismo = 0.004        # seismogram sampling interval [s]

# --- Source ---
sourceType = ricker2    # ricker0 … ricker4
sourceFreq = 10.0       # peak frequency [Hz]

# --- Absorbing boundary (sponge) ---
sponge_x = 200.0        # sponge thickness in X [m]
sponge_y = 200.0        # sponge thickness in Y [m]
sponge_z = 200.0        # sponge thickness in Z [m]
surface_sponge = False  # apply sponge on free surface
taper_delta = 0.015

# --- Physics ---
physic_type = ACOUSTIC  # ACOUSTIC or ELASTIC
